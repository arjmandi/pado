<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~/Library/LaunchAgents/com.local.agentd.weekly.plist

    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.local.agentd.weekly.plist
    launchctl kickstart gui/$(id -u)/com.local.agentd.weekly   # run it now
    launchctl bootout gui/$(id -u)/com.local.agentd.weekly     # remove

  Runs the weekly report every Monday 09:00. launchd runs a missed slot on
  the next wake, so a closed laptop on Monday morning means "late", not
  "skipped". Replace CHANGEME with the real home directory on reinstall.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.agentd.weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/CHANGEME/bin/weekly-report.py</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/CHANGEME</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/CHANGEME/agents/logs/weekly.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/CHANGEME/agents/logs/weekly.err.log</string>
</dict>
</plist>
